{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JackOfNoneTrades/PastFootsteps/blob/main/docs/schemas/gaits.schema.json",
  "title": "Past Footsteps gait profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gaits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gaits": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
      "additionalProperties": { "$ref": "#/definitions/gait" }
    }
  },
  "definitions": {
    "gait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "walk": { "$ref": "#/definitions/contacts" },
        "run": { "$ref": "#/definitions/contacts" }
      },
      "anyOf": [
        { "required": ["walk"] },
        { "required": ["enabled"], "properties": { "enabled": { "const": false } } }
      ]
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/definitions/contact" }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["footId", "phase", "lateral", "forward"],
      "properties": {
        "footId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "phase": { "type": "number", "minimum": 0.000001, "maximum": 1 },
        "lateral": { "type": "number", "minimum": -4, "maximum": 4 },
        "forward": { "type": "number", "minimum": -4, "maximum": 4 }
      }
    }
  }
}
